<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>scion-capture</AssemblyName>
    <RootNamespace>Scion.Capture</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildProjectDirectory)\..\Publish\</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
	<ApplicationIcon>..\artwork\scion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scion.Common\Scion.Common.csproj" />
  </ItemGroup>
</Project>
